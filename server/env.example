#-----------------------------Security-----------------------------------
# Copy these into the process environment. Do not commit real secrets.

NODE_ENV=development
PORT=5001

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies (use COOKIE_SAMESITE=none with HTTPS when UI and API are on different sites)
COOKIE_SAMESITE=lax
FORCE_SECURE_COOKIES=false

CORS_ORIGINS=http://localhost:5173,https://manuals-preceding-very-concentration.trycloudflare.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=500

# Account lockout
LOCKOUT_MAX_ATTEMPTS=50
LOCKOUT_DURATION_MS=900000
LOCKOUT_WINDOW_MS=900000

# HTTPS / SSL / TLS (direct Node TLS — optional if NGINX terminates SSL)
HTTPS_ENABLED=false
FORCE_HTTPS=false
HTTPS_PORT=443
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=

# Reverse proxy (NGINX)
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Firewall — comma-separated IPs. ALLOWED_IPS empty means allow all except blocked.
FIREWALL_BLOCKED_IPS=
FIREWALL_ALLOWED_IPS=
MAX_JSON_BODY=100kb
MAX_URLENCODED_BODY=100kb
AI_BACKEND=http://localhost:8000
OLLAMA_API_KEY=



 
#-----------------------------Admin-----------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

#-----------------------------DB Connectivity-----------------------------------

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Mysql@2025
DB_NAME=datapro_lms
DB_POOL_SIZE=10

#-----------------------------Supabase Storage-----------------------------------
# Public buckets: course-content, employees, programs, daily-reports, students
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

#-----------------------------Mail (password reset OTP)-----------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# Manual page where students can create an Ollama API key
OLLAMA_API_KEY_GUIDE_URL=

# Google sign-in for students. Create a Web client in Google Cloud.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=